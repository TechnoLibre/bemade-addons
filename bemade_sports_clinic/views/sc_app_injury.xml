<?xml version="1.0" encoding="utf-8"?>
<!--
    Task 1539 (epic #1535) — P2 injury pages of the portal app shell: new
    injury (device draft + « Créer »), injury edit (saved field by field on
    blur, status / visibility instant with undo), treatment notes and injury
    documents. Task 1579 retired the « created » landing (a create redirects
    to the player's Injuries tab); task 1581 retired the note-history page
    (the injury page's notes-history sheet, sc_note_history_fragment).

    Rendered only with the system switch on (controllers: _sc_render). The
    clinic's modal fragments (portal_injury_form_body,
    portal_injury_create_form_body), their routes, the clinic's partial save
    (/my/injury/save partial=1) and portal_treatment_note_edit_form are NOT
    modified — the clinic keeps them until P3. Every form posts to the SAME
    routes as today. No inline script / style.
-->
<odoo>

    <!--
        The new-injury form (device drafts until « Create »): the
        /my/patient/injury/new page and the player page's inline « Add
        Injury » card (owner review 2026-10-10). Variables: patient,
        return_url, team_context_id, clinic_event, is_treatment_prof,
        sc_draft_prefix, sc_consent_options, cancel_url (page only).
    -->
    <template id="sc_injury_new_form" name="App shell: new injury form">
        <form action="/my/patient/injury/create" method="post" class="o_sc_form" data-sc-form="injury.new"
              t-att-data-sc-draft-prefix="sc_draft_prefix">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <input type="hidden" name="patient_id" t-att-value="patient.id"/>
            <input type="hidden" name="return_url" t-att-value="return_url"/>
            <input t-if="team_context_id" type="hidden" name="team_context_id" t-att-value="team_context_id"/>
            <input t-if="clinic_event" type="hidden" name="clinic_id" t-att-value="clinic_event.id"/>
            <div class="o_sc_grid2">
                <div class="o_sc_card o_sc_fields">
                    <t t-set="lbl">Diagnosis/Description</t>
                    <t t-call="bemade_sports_clinic.sc_field_autosave">
                        <t t-set="props" t-value="sc_draft_props(sc_draft_prefix + 'diagnosis', 'diagnosis', lbl, 'text', required=True)"/>
                    </t>
                    <t t-set="lbl">Date of Injury</t>
                    <t t-set="hint">Check N/A if exact date is unknown</t>
                    <t t-call="bemade_sports_clinic.sc_field_autosave">
                        <t t-set="props" t-value="sc_draft_props(sc_draft_prefix + 'injury_date', 'injury_date', lbl, 'date_na', value=datetime.date.today().isoformat(), naName='injury_date_na', required=True, hint=hint)"/>
                    </t>
                    <t t-if="is_treatment_prof and sc_can('injury.tp_fields')">
                        <t t-set="lbl">Predicted Resolution Date</t>
                        <t t-call="bemade_sports_clinic.sc_field_autosave">
                            <t t-set="props" t-value="sc_draft_props(sc_draft_prefix + 'predicted_resolution_date', 'predicted_resolution_date', lbl, 'date')"/>
                        </t>
                        <t t-set="lbl">Parental Consent</t>
                        <t t-call="bemade_sports_clinic.sc_field_autosave">
                            <t t-set="props" t-value="sc_draft_props(sc_draft_prefix + 'parental_consent', 'parental_consent', lbl, 'select', options=sc_consent_options, required=True)"/>
                        </t>
                        <label class="o_sc_check">
                            <input type="checkbox" name="hidden_from_coaches" value="1"/>
                            <span>Hide from coaches</span>
                        </label>
                    </t>
                </div>
                <div class="o_sc_card o_sc_fields">
                    <t t-set="lbl">External Notes</t>
                    <t t-set="hint">Notes visible to all team members</t>
                    <t t-call="bemade_sports_clinic.sc_field_autosave">
                        <t t-set="props" t-value="sc_draft_props(sc_draft_prefix + 'external_notes', 'external_notes', lbl, 'textarea', hint=hint)"/>
                    </t>
                    <t t-if="is_treatment_prof and sc_can('injury.internal_notes')">
                        <t t-set="lbl">Internal Notes (Medical Staff Only)</t>
                        <t t-set="hint">Notes visible only to treatment professionals</t>
                        <t t-call="bemade_sports_clinic.sc_field_autosave">
                            <t t-set="props" t-value="sc_draft_props(sc_draft_prefix + 'internal_notes', 'internal_notes', lbl, 'textarea', hint=hint)"/>
                        </t>
                    </t>
                </div>
            </div>
            <div t-attf-class="#{'o_sc_actionbar' if cancel_url else 'o_sc_form_actions'}">
                <a t-if="cancel_url" t-att-href="cancel_url" class="o_sc_btn o_sc_btn_ghost">Cancel</a>
                <button type="submit" class="o_sc_btn o_sc_btn_primary" data-sc-action="injury.create">
                    <span t-if="is_treatment_prof">Create Injury</span>
                    <span t-else="">Submit Report</span>
                </button>
            </div>
        </form>
    </template>


    <!-- /my/patient/injury/new?patient_id=<id> (shell): nothing is created
         before « Créer » — the typing is a device draft (sc_autosave_field,
         draft mode) and the form posts to today's create route. -->
    <template id="sc_app_injury_new" name="Sports Clinic App: new injury">
        <t t-call="bemade_sports_clinic.sc_app_layout">
            <t t-if="is_treatment_prof">
                <t t-set="sc_title">Add Injury</t>
            </t>
            <t t-else="">
                <t t-set="sc_title">Report Injury</t>
            </t>
            <t t-set="sc_active_nav" t-value="'players'"/>
            <t t-if="error" t-call="bemade_sports_clinic.sc_banner">
                <t t-set="tone" t-value="'warn'"/>
                <t t-out="error"/>
            </t>
            <t t-call="bemade_sports_clinic.sc_banner">
                <t t-set="title">Kept on this device until you create it</t>
                What you type stays a draft on this device; nobody is notified before « Create ».
            </t>
            <t t-call="bemade_sports_clinic.sc_injury_new_form">
                <t t-set="cancel_url" t-value="return_url"/>
            </t>
        </t>
    </template>

    <!-- /my/injury/edit?injury_id=<id> (shell): every field saved when the
         user leaves it (/my/app/save — one note-history row per changed note
         field); status and visibility save on click, with « Annuler ». -->
    <template id="sc_app_injury_edit" name="Sports Clinic App: injury edit">
        <t t-call="bemade_sports_clinic.sc_app_layout">
            <t t-set="sc_injury_fallback">Injury</t>
            <t t-set="sc_title" t-value="injury.diagnosis or sc_injury_fallback"/>
            <t t-set="sc_active_nav" t-value="'players'"/>
            <t t-set="sc_flash" t-value="sc_injury_flash"/>
            <t t-call="bemade_sports_clinic.sc_flash_banners"/>
            <!-- Owner review 2026-10-11: the pencil edit paradigm — read views,
                 ONE pencil per card reveals its fields (saved as you leave
                 each one; status and visibility at once, with « Undo »). -->
            <div class="o_sc_grid2">
                <section class="o_sc_card o_sc_edit_card" data-sc-edit-card="injury-details" data-sc-section="injury.details"
                         data-sc-edit-reload="1">
                    <t t-call="bemade_sports_clinic.sc_edit_card_head">
                        <t t-set="title">Details</t>
                        <t t-set="editable" t-value="True"/>
                    </t>
                    <dl class="o_sc_kv" data-sc-edit-view="read">
                        <t t-call="bemade_sports_clinic.sc_display_row"><t t-set="label">Diagnosis/Description</t><t t-set="record" t-value="injury"/><t t-set="field" t-value="'diagnosis'"/></t>
                        <t t-call="bemade_sports_clinic.sc_display_row"><t t-set="label">Date of Injury</t><t t-set="record" t-value="injury"/><t t-set="field" t-value="'sc_injury_date'"/></t>
                        <t t-call="bemade_sports_clinic.sc_display_row"><t t-set="label">Injury status</t><t t-set="record" t-value="injury"/><t t-set="field" t-value="'stage'"/></t>
                        <t t-if="sc_is_tp_view and sc_can('injury.tp_fields')">
                            <t t-call="bemade_sports_clinic.sc_display_row"><t t-set="label">Predicted Resolution Date</t><t t-set="record" t-value="injury"/><t t-set="field" t-value="'predicted_resolution_date'"/></t>
                            <t t-call="bemade_sports_clinic.sc_display_row"><t t-set="label">Resolution Date</t><t t-set="record" t-value="injury"/><t t-set="field" t-value="'resolution_date'"/></t>
                            <t t-call="bemade_sports_clinic.sc_display_row"><t t-set="label">Parental Consent</t><t t-set="record" t-value="injury"/><t t-set="field" t-value="'parental_consent'"/></t>
                        </t>
                        <t t-if="sc_is_tp_view and sc_can('injury.visibility.edit')">
                            <t t-call="bemade_sports_clinic.sc_display_row"><t t-set="label">Visibility</t><t t-set="record" t-value="injury"/><t t-set="field" t-value="'hidden_from_coaches'"/></t>
                        </t>
                    </dl>
                    <div class="o_sc_fields" data-sc-edit-view="edit" hidden="hidden">
                        <t t-set="lbl">Diagnosis/Description</t>
                        <t t-if="sc_diagnosis_editable" t-call="bemade_sports_clinic.sc_field_autosave">
                            <t t-set="props" t-value="sc_field_props(injury, 'diagnosis', lbl)"/>
                        </t>
                        <t t-set="lbl">Date of Injury</t>
                        <t t-call="bemade_sports_clinic.sc_field_autosave">
                            <t t-set="props" t-value="sc_field_props(injury, 'sc_injury_date', lbl, 'date_na')"/>
                        </t>
                        <t t-if="sc_is_tp_view and sc_can('injury.stage.edit')">
                            <t t-set="lbl">Injury status</t>
                            <t t-set="undo_lbl">Status changed</t>
                            <t t-call="bemade_sports_clinic.sc_field_autosave">
                                <t t-set="props" t-value="sc_field_props(injury, 'stage', lbl, 'segmented', options=sc_stage_options, instant=True, undoMessage=undo_lbl)"/>
                            </t>
                        </t>
                        <t t-if="sc_is_tp_view and sc_can('injury.tp_fields')">
                            <t t-set="lbl">Predicted Resolution Date</t>
                            <t t-call="bemade_sports_clinic.sc_field_autosave">
                                <t t-set="props" t-value="sc_field_props(injury, 'predicted_resolution_date', lbl, 'date')"/>
                            </t>
                            <t t-set="lbl">Resolution Date</t>
                            <t t-call="bemade_sports_clinic.sc_field_autosave">
                                <t t-set="props" t-value="sc_field_props(injury, 'resolution_date', lbl, 'date')"/>
                            </t>
                            <t t-set="lbl">Parental Consent</t>
                            <t t-call="bemade_sports_clinic.sc_field_autosave">
                                <t t-set="props" t-value="sc_field_props(injury, 'parental_consent', lbl, 'select', options=sc_consent_options)"/>
                            </t>
                        </t>
                        <t t-if="sc_is_tp_view and sc_can('injury.visibility.edit')">
                            <t t-set="lbl">Visibility</t>
                            <t t-set="undo_lbl">Visibility changed</t>
                            <t t-call="bemade_sports_clinic.sc_field_autosave">
                                <t t-set="props" t-value="sc_field_props(injury, 'hidden_from_coaches', lbl, 'segmented', options=sc_visibility_options, instant=True, undoMessage=undo_lbl)"/>
                            </t>
                        </t>
                        <t t-call="bemade_sports_clinic.sc_edit_card_done"/>
                    </div>
                </section>
                <section class="o_sc_card o_sc_edit_card" data-sc-edit-card="injury-notes" data-sc-section="injury.notes">
                    <!-- Task 1581: « History » opens the shared notes-history
                         sheet (fresh on every open), reachable while reading. -->
                    <t t-set="sc_note_history_label">History</t>
                    <div class="o_sc_edit_card_head">
                        <h3 class="o_sc_edit_card_title">Notes</h3>
                        <span class="o_sc_card_icons">
                            <button type="button" class="o_sc_link_btn" data-sc-sheet-open="sc_note_history_sheet"
                                    t-out="sc_note_history_label"/>
                            <t t-set="sc_edit_label">Edit</t>
                            <button type="button" class="o_sc_icon_btn" data-sc-edit-toggle="1" aria-expanded="false"
                                    t-att-aria-label="sc_edit_label" t-att-title="sc_edit_label">
                                <t t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="'edit'"/></t>
                            </button>
                        </span>
                    </div>
                    <dl class="o_sc_kv o_sc_kv_stacked" data-sc-edit-view="read">
                        <dt>External Notes</dt>
                        <dd><span class="o_sc_pre" t-att-data-sc-display="sc_display_key(injury, 'external_notes')" t-out="injury.external_notes or '—'"/></dd>
                        <t t-if="sc_is_tp_view and sc_can('injury.internal_notes')">
                            <dt>Internal Notes (Medical Staff Only)</dt>
                            <dd><span class="o_sc_pre" t-att-data-sc-display="sc_display_key(injury, 'internal_notes')" t-out="injury.internal_notes or '—'"/></dd>
                        </t>
                    </dl>
                    <!-- Task 1582: both notes use the « replace » editor (the
                         current text above an empty « New note »), each with
                         its own scoped « History » sheet. -->
                    <div class="o_sc_fields" data-sc-edit-view="edit" hidden="hidden">
                        <t t-set="sc_note_placeholder">Write the injury's current state — replaces the previous text</t>
                        <t t-set="lbl">External Notes</t>
                        <t t-call="bemade_sports_clinic.sc_field_autosave">
                            <t t-set="props" t-value="sc_field_props(injury, 'external_notes', lbl, 'textarea', clearable=True, hint=injury.last_external_note_info or None, replace=True, placeholder=sc_note_placeholder, historySheet='sc_note_history_sheet_external', historyLabel=sc_note_history_label)"/>
                        </t>
                        <t t-if="sc_is_tp_view and sc_can('injury.internal_notes')">
                            <t t-set="lbl">Internal Notes (Medical Staff Only)</t>
                            <t t-call="bemade_sports_clinic.sc_field_autosave">
                                <t t-set="props" t-value="sc_field_props(injury, 'internal_notes', lbl, 'textarea', clearable=True, hint=injury.last_internal_note_info or None, replace=True, placeholder=sc_note_placeholder, historySheet='sc_note_history_sheet_internal', historyLabel=sc_note_history_label)"/>
                            </t>
                        </t>
                        <t t-call="bemade_sports_clinic.sc_edit_card_done"/>
                    </div>
                    <div class="o_sc_actions_row">
                        <a t-att-href="sc_documents_url" class="o_sc_btn o_sc_btn_ghost o_sc_btn_sm" data-sc-action="injury.documents">
                            <t t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="'documents'"/></t>
                            <span>Documents</span>
                        </a>
                    </div>
                    <t t-call="bemade_sports_clinic.sc_sheet">
                        <t t-set="sheet_id" t-value="'sc_note_history_sheet'"/>
                        <t t-set="title">Note History</t>
                        <t t-set="lazy_url" t-value="sc_note_history_url"/>
                        <t t-set="lazy_fresh" t-value="True"/>
                    </t>
                    <t t-call="bemade_sports_clinic.sc_sheet">
                        <t t-set="sheet_id" t-value="'sc_note_history_sheet_external'"/>
                        <t t-set="title">External Notes History</t>
                        <t t-set="lazy_url" t-value="sc_note_history_url + '?scope=external'"/>
                        <t t-set="lazy_fresh" t-value="True"/>
                    </t>
                    <t t-if="sc_is_tp_view and sc_can('injury.internal_notes')" t-call="bemade_sports_clinic.sc_sheet">
                        <t t-set="sheet_id" t-value="'sc_note_history_sheet_internal'"/>
                        <t t-set="title">Internal Notes History</t>
                        <t t-set="lazy_url" t-value="sc_note_history_url + '?scope=internal'"/>
                        <t t-set="lazy_fresh" t-value="True"/>
                    </t>
                </section>
            </div>
            <div class="o_sc_actionbar">
                <button t-if="sc_is_tp_view and sc_can('injury.delete')" type="button" class="o_sc_btn o_sc_btn_danger"
                        data-sc-sheet-open="sc_delete_injury_sheet" data-sc-action="injury.delete">Delete</button>
                <a t-att-href="return_url" class="o_sc_btn o_sc_btn_primary" data-sc-action="injury.done">Done</a>
            </div>
            <t t-if="sc_is_tp_view and sc_can('injury.delete')" t-call="bemade_sports_clinic.sc_confirm_sheet">
                <t t-set="sheet_id" t-value="'sc_delete_injury_sheet'"/>
                <t t-set="title">Delete Injury</t>
                <t t-set="message">This will also delete its treatment notes, documents and activity history. This action cannot be undone.</t>
                <t t-set="action" t-value="'/my/injury/delete'"/>
                <t t-set="hidden" t-value="dict([('injury_id', injury.id), ('return_url', return_url)] + ([('team_id', team_context_id)] if team_context_id else []) + ([('clinic_id', clinic_event.id)] if clinic_event else []))"/>
                <t t-set="confirm_label">Yes, Delete Injury</t>
                <t t-set="danger" t-value="True"/>
            </t>
        </t>
    </template>

    <!-- /my/patient/notes?patient_id=<id> (shell): the note cards (editable
         in place by their author / a clinic admin, saved on blur) and the
         « Ajouter » device draft posting to today's /my/injury/note/add. -->
    <template id="sc_app_treatment_notes" name="Sports Clinic App: treatment notes">
        <t t-call="bemade_sports_clinic.sc_app_layout">
            <t t-set="sc_title">Treatment Notes</t>
            <t t-set="sc_active_nav" t-value="'players'"/>
            <t t-call="bemade_sports_clinic.sc_flash_banners"/>
            <div t-if="success == 'note_added'" t-att-data-sc-draft-clear="sc_note_draft_prefix" hidden="hidden"/>
            <t t-if="is_treatment_prof" t-call="bemade_sports_clinic.sc_note_add_form">
                <t t-set="note_patient" t-value="patient"/>
                <t t-set="note_return_url" t-value="notes_return_url"/>
                <t t-set="note_injury_choices" t-value="sc_injury_choices"/>
                <t t-set="note_draft_prefix" t-value="sc_note_draft_prefix"/>
            </t>
            <div t-if="notes" class="o_sc_list" data-sc-section="notes.list">
                <t t-foreach="notes" t-as="note">
                    <t t-call="bemade_sports_clinic.sc_note_card">
                        <t t-set="injury_url" t-value="note.injury_id and '/my/injury/edit?injury_id=%s%s' % (note.injury_id.id, ctx_qs or '')"/>
                        <t t-set="edit_props" t-value="sc_note_props.get(note.id)"/>
                    </t>
                </t>
            </div>
            <t t-else="" t-call="bemade_sports_clinic.sc_empty_state">
                <t t-set="message">No treatment notes recorded</t>
            </t>
        </t>
    </template>


    <!-- /my/injury/documents?injury_id=<id> (shell): list, download, upload
         (therapists), delete (therapists, POST + CSRF, task 1544). -->
    <template id="sc_app_injury_documents" name="Sports Clinic App: injury documents">
        <t t-call="bemade_sports_clinic.sc_app_layout">
            <t t-set="sc_title">Documents</t>
            <t t-set="sc_active_nav" t-value="'players'"/>
            <t t-call="bemade_sports_clinic.sc_flash_banners"/>
            <details t-if="is_treatment_prof and sc_can('documents.upload')" class="o_sc_card o_sc_disclosure"
                     data-sc-section="documents.upload">
                <summary class="o_sc_disclosure_summary">
                    <t t-call="bemade_sports_clinic.sc_icon"><t t-set="icon" t-value="'upload'"/></t>
                    <span>Upload Document</span>
                </summary>
                <form action="/my/injury/document/upload" method="post" enctype="multipart/form-data" class="o_sc_form">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="injury_id" t-att-value="injury.id"/>
                    <t t-foreach="sc_nav_hidden.items()" t-as="nav_item">
                        <input type="hidden" t-att-name="nav_item[0]" t-att-value="nav_item[1]"/>
                    </t>
                    <div class="o_sc_field">
                        <label for="sc_idoc_name" class="o_sc_field_label">Name</label>
                        <input type="text" id="sc_idoc_name" name="document_name" class="o_sc_input" placeholder="Document name"/>
                    </div>
                    <div class="o_sc_field">
                        <label for="sc_idoc_category" class="o_sc_field_label">Category</label>
                        <select id="sc_idoc_category" name="category" class="o_sc_input o_sc_select">
                            <t t-foreach="categories" t-as="cat">
                                <option t-att-value="cat[0]" t-out="cat[1]"/>
                            </t>
                        </select>
                    </div>
                    <div class="o_sc_field">
                        <label for="sc_idoc_description" class="o_sc_field_label">Description</label>
                        <textarea id="sc_idoc_description" name="description" class="o_sc_input o_sc_textarea" rows="2"/>
                    </div>
                    <div class="o_sc_field">
                        <label for="sc_idoc_file" class="o_sc_field_label">File</label>
                        <input type="file" id="sc_idoc_file" name="attachment" class="o_sc_input" required="required"/>
                        <small class="o_sc_hint">Max size 10MB</small>
                    </div>
                    <div class="o_sc_form_actions">
                        <button type="submit" class="o_sc_btn o_sc_btn_primary">Upload</button>
                    </div>
                </form>
            </details>
            <div t-if="sc_document_rows" class="o_sc_list" data-sc-section="documents.list">
                <t t-foreach="sc_document_rows" t-as="drow">
                    <t t-set="can_delete" t-value="is_treatment_prof and sc_can('documents.delete')"/>
                    <t t-call="bemade_sports_clinic.sc_document_row">
                        <t t-set="doc" t-value="drow['doc']"/>
                        <t t-set="meta" t-value="drow['meta']"/>
                        <t t-set="download_url" t-value="'/my/injury/document/download/%s' % drow['doc'].id"/>
                        <t t-set="delete_sheet" t-value="can_delete and ('sc_delete_document_%s' % drow['doc'].id)"/>
                    </t>
                    <t t-if="can_delete" t-call="bemade_sports_clinic.sc_confirm_sheet">
                        <t t-set="sheet_id" t-value="'sc_delete_document_%s' % drow['doc'].id"/>
                        <t t-set="title">Delete this document?</t>
                        <t t-set="message" t-value="drow['doc'].name"/>
                        <t t-set="action" t-value="'/my/injury/document/delete/%s' % drow['doc'].id"/>
                        <t t-set="hidden" t-value="sc_nav_hidden"/>
                        <t t-set="confirm_label">Delete</t>
                        <t t-set="danger" t-value="True"/>
                    </t>
                </t>
            </div>
            <t t-else="" t-call="bemade_sports_clinic.sc_empty_state">
                <t t-set="message">No documents uploaded</t>
            </t>
        </t>
    </template>

    <!-- Task 1581: /my/injury/<id>/notes/history/fragment — the injury notes
         history sheet's body: the scope chips (therapists only) re-fetch it
         inside the sheet (data-sc-sheet-refetch, sc_app_ui.js). -->
    <template id="sc_note_history_fragment" name="App shell: injury note history">
        <t t-set="empty_message">No note history yet.</t>
        <t t-call="bemade_sports_clinic.sc_history_list">
            <t t-set="section" t-value="'injury.notes.history'"/>
            <nav t-if="is_treatment_prof" class="o_sc_segmented o_sc_segmented_full" role="group"
                 aria-label="Scope filter" data-sc-section="history.scope">
                <a t-att-href="sc_scope_urls['all']" data-sc-sheet-refetch="1"
                   t-att-aria-pressed="'true' if scope == 'all' else 'false'">All notes</a>
                <a t-att-href="sc_scope_urls['internal']" data-sc-sheet-refetch="1"
                   t-att-aria-pressed="'true' if scope == 'internal' else 'false'">Internal notes</a>
                <a t-att-href="sc_scope_urls['external']" data-sc-sheet-refetch="1"
                   t-att-aria-pressed="'true' if scope == 'external' else 'false'">External notes</a>
            </nav>
        </t>
    </template>

</odoo>
